# Scripts de backend. Copiar a .env y rellenar. .env nunca se commitea.

SUPABASE_URL=https://<proyecto>.supabase.co

# Settings → API Keys → service_role (o sb_secret_...). Necesaria para escribir.
SUPABASE_SERVICE_ROLE_KEY=

# TMDB → Ajustes → API → Token de acceso de lectura.
TMDB_TOKEN=

# platform.deepseek.com/api_keys — solo para analyze_movies.py
DEEPSEEK_API_KEY=
